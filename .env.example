# ===== 佳明健康助手 配置模板（仓 B） =====
# 复制为 .env 并填入真实值（.env 已被 .gitignore 忽略，不会入库）

# ---------- 数据衔接（读取仓 A 的产出） ----------
# 仓 A（garmin-auto-sync）产出的 garmin-data/ 目录路径。
# 默认取同级 ../Garmin_auto_sync/garmin-data；若仓 A 目录名不同（例如中文名「佳明运动数据同步」），
# 请填绝对路径，例如：C:/Users/you/WorkBuddy/佳明运动数据同步/garmin-data
GARMIN_DATA_DIR=../Garmin_auto_sync/garmin-data
# 本仓（仓 B）自身分析产出的写入目录；默认 ./assistant-data
ASSISTANT_DATA_DIR=./assistant-data

# ---------- AI 分析层（DeepSeek，OpenAI 兼容） ----------
# 在 https://platform.deepseek.com 获取 API Key
DEEPSEEK_API_KEY=
# 兼容接口地址（默认即可）
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
# 模型（deepseek-chat 便宜、中文强；deepseek-reasoner 推理更强但更慢更贵）
DEEPSEEK_MODEL=deepseek-chat
# 没有 Key 时自动启用本地规则兜底（无需联网也能出建议）
AI_FALLBACK_RULES=true

# ---------- 飞书推送（群机器人 Webhook + 消息卡片） ----------
# 群机器人 webhook 地址：飞书群 -> 设置 -> 群机器人 -> 添加机器人 -> 复制 Webhook
FEISHU_WEBHOOK_URL=
# 签名密钥（创建机器人时若开启"签名校验"则填写；不开启可留空）
FEISHU_SECRET=

# ---------- 个人微信推送（WxPusher，免费） ----------
# https://wxpusher.zjiecode.com 创建应用，获取 appToken
WXPUSHER_APP_TOKEN=
# 接收用户 UID（关注公众号后在「我的」里复制 uid，多个用逗号分隔）
WXPUSHER_UIDS=
# 主题 ID（可选；在应用里建主题后填入，按主题推送，与 uids 二选一或并用）
WXPUSHER_TOPIC_IDS=

# ---------- Web 仪表盘 ----------
# 仪表盘监听地址与端口
DASH_HOST=127.0.0.1
DASH_PORT=8000
# 外网访问地址（内网穿透/公网域名，用于飞书卡片跳转；本地可留空）
DASH_PUBLIC_URL=
